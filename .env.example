# Copia este archivo a .env y ajusta lo que necesites:  cp .env.example .env
# (.env está en .gitignore y NUNCA se sube.)

# --- Amazon Bedrock ---
# Región con acceso a Claude en Bedrock.
AWS_REGION=us-east-1

# Inference profile de Claude (clase Sonnet), con prefijo regional us./eu.
# CONFIRMA el ID vigente en tu región (cambia con cada release):
# https://docs.aws.amazon.com/bedrock/latest/userguide/models-supported.html
BEDROCK_MODEL_ID=us.anthropic.claude-sonnet-4-5-20250929-v1:0

BEDROCK_MAX_TOKENS=2000
BEDROCK_TEMPERATURE=0.2

# Motor de decisión: "bedrock" (Claude real) o "fake" (heurística local SIN AWS).
# Pon "fake" para probar el loop completo antes de tener credenciales; cámbialo a
# "bedrock" cuando Bedrock esté conectado.
HAKU_DECIDE_BACKEND=bedrock

# NOTA: las credenciales AWS NO van aquí. Se toman de la cadena estándar de AWS
# (rol de instancia, ~/.aws/credentials, o variables AWS_ACCESS_KEY_ID / etc.).

# --- Transcripción (faster-whisper, sin torch) ---
# tiny / base / small / medium  (más grande = mejor y más lento)
WHISPER_MODEL_SIZE=small

# --- Datos ---
# Base de datos. Para migrar a Postgres luego, cambia SOLO esta línea:
#   HAKU_DB_URL=postgresql+psycopg://user:pass@host:5432/haku
HAKU_DB_URL=sqlite:///data/haku.sqlite

# Carpeta de videos locales que la UI ofrece para elegir.
HAKU_VIDEOS_DIR=data/videos
